# ESPN Fantasy Football league configuration.
# Copy to .env (which is gitignored) and fill in real values.

# Numeric league ID — visible in the URL when you view your league on espn.com,
# e.g. https://fantasy.espn.com/football/league?leagueId=123456
ESPN_LEAGUE_ID=

# Season year, e.g. 2025
ESPN_YEAR=

# The name of your own team exactly as it appears in ESPN, used to default the
# CLI's roster/trade commands to your team. Optional — falls back to the team
# owned by the authenticated user.
ESPN_TEAM_NAME=

# --- Private league auth ---------------------------------------------------
# Only required for private leagues. To get these:
#   1. Log in to https://fantasy.espn.com in a browser and open your league.
#   2. Open DevTools -> Application (Chrome) / Storage (Firefox) -> Cookies
#      -> https://fantasy.espn.com
#   3. Copy the values of the `espn_s2` and `SWID` cookies.
# The SWID value includes the surrounding braces, e.g. {ABC12345-...}.
# These are session credentials — never commit them or paste them into chat.
ESPN_S2=
ESPN_SWID=
